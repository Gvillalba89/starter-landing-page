---
import { siteConfig } from '../../config/siteConfig';

const year = new Date().getFullYear();
---

<footer class="border-t border-stone-900 px-6 py-12">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
	>
		<p class="text-sm text-stone-500">
			© {year}
			{siteConfig.name}. {siteConfig.footer.rights}
		</p>

		<ul class="flex flex-wrap gap-5">
			{
				siteConfig.social.map((item) => (
					<li>
						<a
							href={item.href}
							target="_blank"
							rel="noopener noreferrer"
							class="text-sm text-stone-400 transition hover:text-amber-400"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
