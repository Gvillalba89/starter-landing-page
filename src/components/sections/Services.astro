---
import { siteConfig } from '../../config/siteConfig';

const { services } = siteConfig;
---

<section id={services.id} class="scroll-mt-24 border-t border-stone-900 px-6 py-24">
	<div class="mx-auto max-w-5xl">
		<div class="max-w-2xl">
			<h2 class="text-3xl font-semibold tracking-tight text-stone-50 sm:text-4xl">
				{services.title}
			</h2>
			<p class="mt-4 text-lg text-stone-400 text-pretty">{services.supporting}</p>
		</div>

		<ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				services.items.map((item, index) => (
					<li class="border-t border-amber-500/40 pt-6">
						<p class="text-xs tracking-widest text-amber-500/80">
							{String(index + 1).padStart(2, '0')}
						</p>
						<h3 class="mt-3 text-xl font-medium text-stone-100">{item.title}</h3>
						<p class="mt-3 text-stone-400 text-pretty">{item.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
